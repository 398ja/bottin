# @Jacksonized builders must be readable by both Jacksons on the class path. By default Lombok
# emits only Jackson 2's @JsonDeserialize, which Jackson 3 (Spring Boot 4's default HTTP
# mapper) ignores, so every create on /api/v1/records and /api/v1/domains answers 500 the
# moment the HTTP layer is on Jackson 3. Generate both.
lombok.jacksonized.jacksonVersion += 2
lombok.jacksonized.jacksonVersion += 3
