# Spring Boot 4 deserialises request bodies with Jackson 3. A @Jacksonized builder carries only
# Jackson 2's @JsonDeserialize by default, which Jackson 3 ignores: every POST to
# /api/v1/records and /api/v1/domains then fails with "Cannot construct instance" and a 500.
# Generate Jackson 3's annotations, and keep Jackson 2's for the Jackson 2 ObjectMapper that
# bottin's services still use.
lombok.jacksonized.jacksonVersion += 2
lombok.jacksonized.jacksonVersion += 3
